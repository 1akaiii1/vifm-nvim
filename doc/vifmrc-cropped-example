" ============================================================================
"  VIFMRC — Configuración para vifm embebido en Neovim
" ============================================================================
source ~/.config/vifm/scripts/favicons.vifm
colorscheme  draculac 

" ----------------------------------------------------------------------------
"  EDITOR
" ----------------------------------------------------------------------------
set vicmd=nvim
set vixcmd=nvim

" ----------------------------------------------------------------------------
"  OPCIONES GENERALES
" ----------------------------------------------------------------------------
set mouse=a
set fillchars=hborder:󰹞
set shortmess+=L
set sort=+iname
set syscalls
set trash
set vifminfo=dhistory,savedirs,chistory,state,tui,tabs,shistory,ehistory,
            \phistory,fhistory,dirstack,registers,bookmarks,bmarks,mchistory

set history=100
set nofollowlinks
set sortnumbers
set undolevels=100
set norunexec
set timefmt='%Y/%m/%d %H:%M'
set wildmenu
set wildstyle=popup
set suggestoptions=normal,visual,view,otherpane,keys,marks,registers
set ignorecase
set smartcase
set nohlsearch
set incsearch
set scrolloff=4
set confirm-=delete

" Status line compacta (sin la pista, que ya ocupa poco espacio)
set statusline="  %A %10u:%-7g %15s %20d  "

" Evita errores "Permission denied" en GNU find
if system("find --version | grep -c 'GNU findutils'") != 0
    set findprg='find %s %a -print , -type d \( ! -readable -o ! -executable \) -prune'
endif

set grepprg="grep -n -H -I -r -s %i %a %s"

" ----------------------------------------------------------------------------
"  KEY MAPPINGS
" ----------------------------------------------------------------------------
" Desactivar Space como leader
qnoremap <Space> <Nop>
nnoremap <Space> <Nop>

" Navegación básica
nnoremap s '
nnoremap < /
qnoremap < /
nnoremap o :file<cr>
nnoremap O :file &<cr>
nnoremap cd :cd<space>
nnoremap <C-l> :cd<space>
nnoremap dt :empty<cr>

" Tabs
nnoremap gn :tabnew<cr>
nnoremap gb :tabnew %f<cr>:tabprevious<cr>
nnoremap gc :tabclose<cr>
nnoremap <tab> :tabnext<cr>
vnoremap <S-tab> :tabprevious<cr>
vnoremap <tab> :tabnext<cr>
nnoremap <S-tab> :tabprevious<cr>
nnoremap g1 1gt
nnoremap g2 2gt
nnoremap g3 3gt
nnoremap g4 4gt

" Vim-like
nnoremap t tj
nnoremap . za
nnoremap Z :sort<cr>
nnoremap zn :sort<cr>N
nnoremap zm :sort<cr>m

" Redimensionar paneles con Ctrl+Alt
nnoremap <C-A-j> 10<c-w>>
nnoremap <C-A-k> 10<c-w><
nnoremap <C-A-l> 10<c-w>>
nnoremap <C-A-h> 10<c-w><

" Cambiar entre paneles
qnoremap <space><space> <C-W><C-W>
nnoremap <space><space> <C-W><C-W>

" Layouts
nnoremap <silent> ww :if layoutis('only') || layoutis('hsplit')
      \ | execute 'vsplit'
      \ | else
      \ | execute 'only'
      \ | endif<cr>

nnoremap <silent> ws :if layoutis('only') || layoutis('vsplit')
      \ | execute 'split'
      \ | else
      \ | execute 'only'
      \ | endif<cr>

nnoremap <silent> e :if layoutis('only')
      \ | execute 'windo set noquickview'
      \ | endif
      \ | execute 'normal e'<cr>

nnoremap W :view<cr>
vnoremap W :view<cr>gv
nnoremap <c-u> <c-w>xq

" Copiar al portapapeles (Wayland)
nnoremap yn :!echo -n %c | wl-copy %i &&
            \ echo -n %c | wl-copy -p %i<cr>
nnoremap yd :!echo -n %d:p/ | wl-copy %i &&
            \ echo -n %d:p/ | wl-copy -p %i<cr>
nnoremap ya :!echo -n %c:p | wl-copy %i &&
            \ echo -n %c:p | wl-copy -p %i<cr>

" Guardar directorio actual y salir → Neovim hará :cd
nnoremap <Space>cd :!echo -n %d:p > "$VIFM_CWD_FILE"<cr>

" Renombrado rápido
nnoremap I cw<c-a>
nnoremap A cw

" Varios
nnoremap <Space>a ggvG
nnoremap <C-s> :shell<cr>
nnoremap ,c :write | edit $MYVIFMRC | restart full<cr>
nnoremap U :set wrap!<cr>

" ----------------------------------------------------------------------------
"  COMANDOS
" ----------------------------------------------------------------------------
command! New bash -c 'dir="%d/%a"; if [[ "%a" == */ ]]; then mkdir -p "$dir"; else mkdir -p "$(dirname "$dir")" && touch "$dir"; fi'
nnoremap <space>nf :New<space>

" ----------------------------------------------------------------------------
"  FILE VIEWER
" ----------------------------------------------------------------------------
" Bat para complementar el preview del plugin cuando activás quickview
fileviewer <text/*> bat --style=numbers --color=always --theme="Catppuccin Frappe" %c

" ----------------------------------------------------------------------------
"  BOOKMARKS
" ----------------------------------------------------------------------------
mark r /
mark h ~/
mark c ~/.config/
mark n ~/.config/nvim/
mark v ~/.config/vifm/
mark l ~/.local/

" vim: filetype=vifm :


